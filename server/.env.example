# Copy this file to .env and fill in the values. Never commit .env.

# Outgoing mail (SMTP). Quote values that contain # or $.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=info@example.com
SMTP_PASS=
MAIL_FROM_NAME=Company Name

# Reading bounce reports (IMAP). Optional: defaults to the SMTP host/user/password above.
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=

# Server
PORT=3000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:4200

# App login
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_TOKEN_HOURS=1
