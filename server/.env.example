# Copy this file to .env and fill in the values. Never commit .env.

# Outgoing mail (SMTP). Quote values that contain # or $.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=info@example.com
SMTP_PASS=
MAIL_FROM_NAME=Company Name

# Reading bounce reports (IMAP). Optional: defaults to the SMTP host/user/password above.
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=

# WhatsApp (Sms4Crm gateway). Leave WHATSAPP_APP_KEY empty to hide the WhatsApp option.
WHATSAPP_API_URL=https://example.com/Sms4Crm/SendMessage
WHATSAPP_APP_KEY=
WHATSAPP_TEMPLATE_NAME=
# Added to local numbers (e.g. 0775555054 -> 967775555054)
WHATSAPP_DEFAULT_COUNTRY_CODE=967
# If the gateway is on another machine in the same network, the app server may not reach the
# public address. Use the gateway's internal address in WHATSAPP_API_URL and put the public host
# name here, so the SSL certificate is still checked against it:
#   WHATSAPP_API_URL=https://192.168.1.20:44397/Sms4Crm/SendMessage
#   WHATSAPP_TLS_SERVERNAME=mdev.yemensoft.net
WHATSAPP_TLS_SERVERNAME=

# Server
PORT=3000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:4200

# App login
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_TOKEN_HOURS=1
