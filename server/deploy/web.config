<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the Customer Mailer backend (the CustomerMailerApi application under Default Web Site).
  Every request is forwarded to the Node server on 127.0.0.1:3000, e.g.
    /CustomerMailerApi/api/login  ->  http://127.0.0.1:3000/api/login
  Requires: URL Rewrite + Application Request Routing (ARR) with "Enable proxy" turned on.
  The Node server itself runs as a Windows scheduled task (see install-service.ps1).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Forward to Node API" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Defence in depth: never serve the server's own files, even if a rewrite rule changes. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="logs" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".js" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
