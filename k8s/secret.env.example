# Copy to k8s/secret.env (git-ignored), fill in, then:
#   kubectl create secret generic customer-mailer-env --from-env-file=k8s/secret.env [-n <namespace>]
#
# IMPORTANT: unlike server/.env, NO quotes here. kubectl takes everything after "=" literally,
# so a quoted password would include the quote characters and the login would fail.
# Only whole-line comments are allowed (a "#" inside a value is part of the value).

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=info@example.com
SMTP_PASS=
MAIL_FROM_NAME=Company Name

ADMIN_USERNAME=Admin
ADMIN_PASSWORD=
AUTH_SECRET=
AUTH_TOKEN_HOURS=1

WHATSAPP_API_URL=https://example.com/Sms4Crm/SendMessage
WHATSAPP_APP_KEY=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_DEFAULT_COUNTRY_CODE=967
WHATSAPP_TLS_SERVERNAME=
